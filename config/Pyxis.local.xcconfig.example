// Copy this file to Pyxis.local.xcconfig and keep the real values out of Git.
// $() prevents xcconfig from treating the URL's double slash as a comment.
PYXIS_AI_BASE_URL = https:/$()/YOUR-WORKER.workers.dev
PYXIS_AI_ACCESS_TOKEN = replace-with-the-worker-access-token
// Optional staging-only try-on testing; Debug builds only. Never a provider key.
// Use the staging Worker's TRY_ON_TEST_TOKEN. Release always strips this value.
PYXIS_TRY_ON_TEST_TOKEN =

// Personal ComfyUI API: Debug only, independent of the cleanup/production gateway.
// PYXIS_PC_BASE_URL = https:/$()/YOUR-PC.YOUR-TAILNET.ts.net:8443
// Set PYXIS_TRY_ON_TEST_TOKEN to the PC API's PYXIS_PC_TOKEN for this build.
