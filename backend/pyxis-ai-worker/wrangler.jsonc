{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pyxis-ai",
  "main": "src/index.js",
  "compatibility_date": "2026-07-16",
  "workers_dev": true,
  "vars": {
    "XAI_MODEL": "grok-imagine-image-quality"
  },
  "ratelimits": [
    {
      "name": "AI_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 6,
        "period": 60
      }
    }
  ]
}
